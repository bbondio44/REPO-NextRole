# Local Docker Compose development only. Never reuse these values in production.
POSTGRES_DB=nextrole
POSTGRES_USER=nextrole
POSTGRES_PASSWORD=nextrole_local

# Base64-encoded development-only key (decoded value is not a production secret).
# Replace it with a private random value for any shared or persistent environment.
JWT_SECRET=bmV4dHJvbGUtbG9jYWwtZGV2ZWxvcG1lbnQtc2VjcmV0LTMyYnl0ZXMh

ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Optional host ports; container-to-container ports remain fixed.
BACKEND_PORT=8090
FRONTEND_PORT=5173
